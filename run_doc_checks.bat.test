@echo off
setlocal enabledelayedexpansion
chcp 65001 >nul
title Project Babel — 文档一致性检查
cd /d "%~dp0"

set FULL_MODE=0
if "%1"=="--full" set FULL_MODE=1
set FAMILY_ARG=
if not "%2"=="" set FAMILY_ARG=--family %2

echo ============================================
echo  Project Babel — 文档一致性检查
echo ============================================
if %FULL_MODE%==1 (
    echo  Mode: 完整 (结构 + LLM 语义)
) else (
    echo  Mode: 仅结构 (使用 --full 启用 LLM)
)
echo.

:: ── Phase 1: 结构检查 ──
echo [Phase 1/2] 结构检查...
dotnet run --project src/DocChecker -- --full %FAMILY_ARG%
set STRUCT_FAIL=%errorlevel%
if %STRUCT_FAIL% neq 0 set STRUCT_FAIL=1

:: ── Phase 2: LLM (gate) ──
echo.
echo ============================================
if !STRUCT_FAIL! neq 0 (
    echo [Phase 2/2] LLM 语义对比: SKIP (结构不一致)
    echo ============================================
    echo 请先修复以上结构问题后重试 --full
) else if %FULL_MODE%==0 (
    echo [Phase 2/2] LLM 语义对比: SKIP (dry-run)
    echo ============================================
    echo 结构全部通过. 使用 --full 启用 LLM 对比.
) else (
    echo [Phase 2/2] LLM 语义对比...
    echo ============================================
    echo.
    dotnet run --project src/DocChecker -- --family %2
    if %errorlevel% neq 0 (
        echo [!] 发现语义不一致
    ) else (
        echo 全部一致
    )
)
echo.
echo ============================================
echo  Done.
echo ============================================
rem pause
