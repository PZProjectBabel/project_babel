# steamcmd/.gitignore — whitelist: only track platform binaries
*

!.gitignore

!steamcmd.exe
!steam.dll
!steamclient.dll
!steamclient64.dll
!steamconsole.dll
!steamconsole64.dll
!tier0_s.dll
!tier0_s64.dll
!vstdlib_s.dll
!vstdlib_s64.dll
!crashhandler.dll
!crashhandler64.dll
!steamerrorreporter.exe

!steamcmd.sh
!linux32/
!linux32/steamcmd
!linux32/steamclient.so
!linux32/libtier0_s.so
!linux32/libvstdlib_s.so
!linux32/crashhandler.so
!linux32/libstdc++.so.6
!linux32/steamconsole.so